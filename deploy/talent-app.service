[Unit]
Description=Talent Assessment Flask App
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/talent-app
Environment="PATH=/opt/talent-app/.venv/bin"
ExecStart=/opt/talent-app/.venv/bin/gunicorn -c gunicorn.conf.py app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
